# ===== Copia este archivo como .env y cambia TODOS los valores =====

# Dominios (deben apuntar a la IP del servidor)
INFORMES_DOMAIN=informes.tucentro.cl
PACS_DOMAIN=pacs.tucentro.cl

# Contraseñas (usa claves largas y distintas)
PG_PASSWORD=cambia-esto-postgres
SECRET_KEY=cambia-esto-por-una-clave-larga-aleatoria

# Primer usuario administrador de la app de informes (se crea al primer arranque)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto-admin-informes

# Identificación del PACS en la red DICOM (configúralo igual en los equipos)
PACS_NOMBRE=PACS
PACS_AET=PACS

# Dónde se guardan las imágenes (idealmente un disco grande con respaldo)
DICOM_STORAGE_DIR=./data/orthanc

# URL pública de la app y del PACS (con https)
PUBLIC_BASE_URL=https://informes.tucentro.cl
PACS_PUBLIC_URL=https://pacs.tucentro.cl
# Dominio común de ambos (con punto inicial): permite entrar al visor con el mismo login
COOKIE_DOMAIN=.tucentro.cl

# Datos que aparecen en el PDF
CENTRO_NOMBRE=Centro de Imágenes
CENTRO_DIRECCION=Dirección, Ciudad
CENTRO_TELEFONO=+56 9 0000 0000
CENTRO_EMAIL=contacto@tucentro.cl

# Links para pacientes
LINK_DIAS_VIGENCIA=60
# Si es true, el paciente debe ingresar una clave de 6 dígitos para abrir el link
LINK_REQUIERE_CLAVE=false

# Dictado opcional con servidor Whisper propio (API compatible con OpenAI).
# Si se deja vacío, se usa el dictado del navegador (Chrome/Edge).
WHISPER_URL=
WHISPER_MODEL=whisper-1
WHISPER_API_KEY=

# Correo saliente para enviar informes a pacientes (Gmail/Workspace, Outlook, etc.)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, y una "contraseña de aplicación"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Centro de Imágenes <informes@tucentro.cl>
SMTP_SSL=false
SMTP_STARTTLS=true
